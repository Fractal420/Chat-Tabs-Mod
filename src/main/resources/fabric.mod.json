{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "icon": "assets/chat_tabs/icon.png",
  "description": "${mod_description}",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.tibiachat.TibiaChatTabsClient"],
    "modmenu": ["com.example.tibiachat.integration.ModMenuIntegration"]
  },
  "mixins": ["tibia_chat_tabs.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft_dependency}",
    "java": "${java_dependency}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}"
}
